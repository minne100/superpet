{
  "cardId": "event_023",
  "type": "event",
  "description": "投骰子大于3的玩家失去5金币",
  "steps": [
    {
      "id": "loop_check",
      "action": "loop",
      "who": "$all",
      "as": "p",
      "do": [
        {
          "id": "roll_{p}",
          "role": {
            "target": { "player": "{p}", "action": "roll_dice" },
            "others": { "action": "wait_dice", "from": "{p}" }
          },
          "on_receive": {
            "message_type": "dice_result",
            "filter": { "sender": "{p}" },
            "handle": { "action": "store", "as": "dice_{p}", "value": "msg.value" }
          }
        },
        {
          "id": "check_{p}",
          "action": "if",
          "condition": "dice_{p} > 3",
          "do": [
            {
              "id": "lose_{p}",
              "action": "remove_gold",
              "target": "{p}",
              "value": 5,
              "floor": 0,
              "role": "all"
            }
          ],
          "role": "all"
        }
      ]
    }
  ]
}
