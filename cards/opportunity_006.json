{
  "cardId": "opportunity_006",
  "type": "opportunity",
  "description": "选择丢弃1张招式卡（无则忽略）",
  "steps": [
    {
      "id": "s01",
      "action": "has_cards?",
      "who": "$trigger",
      "card_type": "move",
      "min": 1,
      "role": "all",
      "fail": { "goto": "end" }
    },
    {
      "id": "s02",
      "action": "choose_discard",
      "role": {
        "actor": {
          "player": "$trigger",
          "action": "pick_discard",
          "filter": "move_only"
        },
        "others": { "action": "wait" }
      },
      "on_receive": {
        "message_type": "card_discarded",
        "filter": { "cardId": "opportunity_006" },
        "handle": { "action": "discard_card", "player": "$trigger", "card": "msg.card" }
      }
    }
  ]
}
