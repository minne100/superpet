{
  "cardId": "event_005",
  "type": "event",
  "description": "投骰子最大的玩家从最小的玩家处夺取6金币（不足则全取）",
  "steps": [
    {
      "id": "dice_loop",
      "action": "loop",
      "who": "$all",
      "as": "p",
      "do": [
        {
          "id": "roll_{p}",
          "role": {
            "target": { "player": "{p}", "action": "roll_dice" },
            "others": { "action": "wait_dice", "from": "{p}" }
          },
          "on_receive": {
            "message_type": "dice_result",
            "filter": { "sender": "{p}" },
            "handle": { "action": "store", "as": "dice_{p}", "value": "msg.value" }
          }
        }
      ]
    },
    {
      "id": "calc",
      "action": "calc",
      "expression": "find_max_min(dice_A, dice_B, dice_C, dice_D)",
      "store": { "max": "$winner", "min": "$loser" },
      "role": "all",
      "tie": { "goto": "dice_loop" }
    },
    {
      "id": "transfer_gold",
      "action": "transfer_gold",
      "from": "$loser",
      "to": "$winner",
      "value": 6,
      "ceil_on_source": true,
      "role": "all"
    }
  ]
}
