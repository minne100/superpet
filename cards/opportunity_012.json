{
  "cardId": "opportunity_012",
  "type": "opportunity",
  "description": "获得n金币（n=投骰子数值），同时选择丢弃一张招式卡或内功卡（无卡则忽略丢弃部分）",
  "steps": [
    {
      "id": "s01",
      "action": "roll_dice",
      "by": "$trigger",
      "store_as": "$n",
      "role": {
        "target": { "player": "$trigger", "action": "roll_dice" },
        "others": { "action": "wait_dice", "from": "$trigger" }
      },
      "on_receive": {
        "message_type": "dice_result",
        "filter": { "sender": "$trigger" },
        "handle": { "action": "store", "as": "$n", "value": "msg.value" }
      }
    },
    {
      "id": "s02",
      "action": "add_gold",
      "target": "$trigger",
      "value": "$n",
      "role": "all"
    },
    {
      "id": "s03",
      "action": "has_cards?",
      "who": "$trigger",
      "card_type": "any",
      "min": 1,
      "role": "all",
      "fail": { "goto": "end" }
    },
    {
      "id": "s04",
      "action": "choose_discard",
      "role": {
        "actor": {
          "player": "$trigger",
          "action": "pick_discard",
          "filter": "move_or_neigong"
        },
        "others": { "action": "wait" }
      },
      "on_receive": {
        "message_type": "card_discarded",
        "filter": { "cardId": "opportunity_012" },
        "handle": { "action": "discard_card", "player": "$trigger", "card": "msg.card" }
      }
    }
  ]
}
